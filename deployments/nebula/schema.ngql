CREATE TAG IF NOT EXISTS business_term(object_id string NOT NULL, object_version string NOT NULL, object_type string NOT NULL, domain_id string NOT NULL, tenant_scope string NOT NULL, status string NOT NULL, sensitivity string NOT NULL, semantic_version string NOT NULL, content_hash string NOT NULL, valid_from int NOT NULL, valid_to int NOT NULL, contract_json string NOT NULL);
