CREATE EDGE IF NOT EXISTS contains(relation_id string NOT NULL, tenant_scope string NOT NULL, certified bool NOT NULL, allowed_for_query bool NOT NULL, cardinality string NOT NULL, base_cost double NOT NULL, fanout_penalty double NOT NULL, stale_penalty double NOT NULL, cross_source_penalty double NOT NULL, policy_penalty double NOT NULL, semantic_version string NOT NULL, effective_from int NOT NULL, effective_to int NOT NULL, attributes_json string NOT NULL);
