CREATE SPACE IF NOT EXISTS smart_query_dev(partition_num=10, replica_factor=1, vid_type=FIXED_STRING(128));
USE smart_query_dev;

CREATE TAG IF NOT EXISTS domain(object_id string NOT NULL, object_version string NOT NULL, object_type string NOT NULL, domain_id string NOT NULL, tenant_scope string NOT NULL, status string NOT NULL, sensitivity string NOT NULL, semantic_version string NOT NULL, content_hash string NOT NULL, valid_from int NOT NULL, valid_to int NOT NULL, contract_json string NOT NULL);
CREATE TAG IF NOT EXISTS entity(object_id string NOT NULL, object_version string NOT NULL, object_type string NOT NULL, domain_id string NOT NULL, tenant_scope string NOT NULL, status string NOT NULL, sensitivity string NOT NULL, semantic_version string NOT NULL, content_hash string NOT NULL, valid_from int NOT NULL, valid_to int NOT NULL, contract_json string NOT NULL);
