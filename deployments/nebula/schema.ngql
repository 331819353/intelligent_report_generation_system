CREATE TAG INDEX IF NOT EXISTS metric_lookup_idx ON metric(tenant_scope(36),semantic_version(64),object_id(64));
CREATE TAG INDEX IF NOT EXISTS dimension_lookup_idx ON dimension(tenant_scope(36),semantic_version(64),object_id(64));
CREATE TAG INDEX IF NOT EXISTS dimension_value_lookup_idx ON dimension_value(tenant_scope(36),semantic_version(64),object_id(64));
CREATE TAG INDEX IF NOT EXISTS dataset_lookup_idx ON dataset(tenant_scope(36),semantic_version(64),object_id(64));
