{
  "dslVersion": "1.0",
  "dataset": {
    "code": "dwd_order_customer_ownership",
    "name": "订单客户归属事实",
    "description": "按照订单事件时间匹配客户 SCD2 归属",
    "type": "SINGLE_SOURCE",
    "layer": "DWD",
    "semanticContractVersion": "1.0"
  },
  "nodes": [
    {"id": "fact_orders", "type": "DATASET", "datasetVersionId": "10000000-0000-4000-8000-000000000005", "alias": "orders", "projection": ["order_id", "customer_key", "ordered_at", "amount"], "sourceFilters": []},
    {"id": "dim_customer_scd2", "type": "DATASET", "datasetVersionId": "20000000-0000-4000-8000-000000000006", "alias": "customer", "projection": ["customer_key", "owner_team", "valid_from", "valid_to"], "sourceFilters": []}
  ],
  "joins": [{
    "id": "join_customer_at_order_time",
    "leftNodeId": "fact_orders",
    "rightNodeId": "dim_customer_scd2",
    "joinType": "LEFT",
    "cardinality": "MANY_TO_ONE",
    "relationshipType": "ROLE_PLAYING",
    "relationshipRole": "CUSTOMER_OWNER_AT_ORDER_TIME",
    "fanoutPolicy": "SAFE",
    "temporal": {
      "eventNodeId": "fact_orders",
      "eventTimeField": "ordered_at",
      "validityNodeId": "dim_customer_scd2",
      "validFromField": "valid_from",
      "validToField": "valid_to",
      "validToInclusive": false
    },
    "conditions": [
      {
        "leftExpression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "customer_key"},
        "operator": "EQUALS",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "dim_customer_scd2", "field": "customer_key"}
      },
      {
        "leftExpression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "ordered_at"},
        "operator": "GTE",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "dim_customer_scd2", "field": "valid_from"}
      },
      {
        "leftExpression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "ordered_at"},
        "operator": "LT",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "dim_customer_scd2", "field": "valid_to"}
      }
    ],
    "manualConfirmed": true
  }],
  "factContract": {
    "businessAction": "客户在当时归属团队下产生订单",
    "grainKeyFields": ["order_id"],
    "eventTimeField": "ordered_at",
    "atomicMeasures": [{"field": "amount", "additivity": "ADDITIVE", "unit": "CNY", "currency": "CNY", "nullPolicy": "REJECT"}]
  },
  "fields": [
    {"id": "field_order_id", "code": "order_id", "name": "订单标识", "role": "IDENTIFIER", "expression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "order_id"}, "canonicalType": "STRING", "nullable": false},
    {"id": "field_ordered_at", "code": "ordered_at", "name": "下单时间", "role": "TIME", "expression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "ordered_at"}, "canonicalType": "DATETIME", "nullable": false},
    {"id": "field_owner_team", "code": "owner_team", "name": "当时归属团队", "role": "DIMENSION", "expression": {"type": "FIELD_REF", "nodeId": "dim_customer_scd2", "field": "owner_team"}, "canonicalType": "STRING", "nullable": true},
    {"id": "field_amount", "code": "amount", "name": "订单金额", "role": "MEASURE", "expression": {"type": "FIELD_REF", "nodeId": "fact_orders", "field": "amount"}, "canonicalType": "DECIMAL", "unit": "CNY", "nullable": false}
  ],
  "filters": [],
  "groupBy": [],
  "having": [],
  "sorts": [],
  "parameters": [],
  "outputGrain": {"description": "每行一个订单及事件时点客户归属", "keyFields": ["order_id"], "timeField": "ordered_at", "defaultTimeGrain": "DAY"},
  "executionPolicy": {"mode": "REALTIME", "timeoutMs": 5000, "previewLimit": 100, "resultLimit": 10000, "cacheTtlSeconds": 0, "materialization": {"enabled": false}}
}
