      "id": "employment",
      "type": "DATASET",
      "datasetVersionId": "30000000-0000-4000-8000-000000000010",
      "alias": "employment",
      "projection": [
        "employee_id",
        "business_track",
        "xiaowei_code",
        "employment_status",
        "key_talent_category"
      ],
      "sourceFilters": []
    }
  ],
  "joins": [],
  "analysisContract": {
    "intent": "DISTRIBUTION",
    "inputMode": "SINGLE_FACT",
