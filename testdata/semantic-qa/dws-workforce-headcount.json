      "name": "员工总人数",
      "role": "MEASURE",
      "expression": {
        "type": "AGGREGATE",
        "function": "COUNT",
        "argument": {
          "type": "FIELD_REF",
          "nodeId": "employment",
          "field": "employee_id"
