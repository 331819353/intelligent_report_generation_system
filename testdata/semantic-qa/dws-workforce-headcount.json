        "type": "FIELD_REF",
        "nodeId": "employment",
        "field": "xiaowei_code"
      },
      "canonicalType": "STRING",
      "nullable": false
    },
    {
      "id": "field_employee_status",
      "code": "employee_status",
      "name": "人员状态",
      "role": "DIMENSION",
      "expression": {
        "type": "FIELD_REF",
        "nodeId": "employment",
        "field": "employment_status"
      },
