{
  "dslVersion": "1.0",
  "dataset": {
    "code": "dwd_order_product_category",
    "name": "订单商品品类事实",
    "description": "通过显式 Bridge 分配商品多品类关系",
    "type": "SINGLE_SOURCE",
    "layer": "DWD",
    "semanticContractVersion": "1.0"
  },
  "nodes": [
    {"id": "fact_order_lines", "type": "DATASET", "datasetVersionId": "10000000-0000-4000-8000-000000000004", "alias": "fact", "projection": ["order_line_id", "product_key", "ordered_at", "line_amount"], "sourceFilters": []},
    {"id": "bridge_product_category", "type": "DATASET", "datasetVersionId": "20000000-0000-4000-8000-000000000004", "alias": "bridge", "projection": ["product_key", "category_key", "relationship_type", "allocation_weight", "valid_from", "valid_to"], "sourceFilters": []},
    {"id": "dim_category", "type": "DATASET", "datasetVersionId": "20000000-0000-4000-8000-000000000005", "alias": "category", "projection": ["category_key", "category_name"], "sourceFilters": []}
  ],
  "joins": [
    {
      "id": "join_product_category_bridge",
      "leftNodeId": "fact_order_lines",
      "rightNodeId": "bridge_product_category",
      "joinType": "LEFT",
      "cardinality": "ONE_TO_MANY",
      "relationshipType": "BRIDGE",
      "relationshipRole": "PRODUCT_CATEGORY",
      "fanoutPolicy": "ALLOCATE",
      "bridge": {
        "bridgeNodeId": "bridge_product_category",
        "relationshipTypeField": "relationship_type",
        "allocationWeightField": "allocation_weight",
        "validFromField": "valid_from",
        "validToField": "valid_to"
      },
      "conditions": [{
        "leftExpression": {"type": "FIELD_REF", "nodeId": "fact_order_lines", "field": "product_key"},
        "operator": "EQUALS",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "bridge_product_category", "field": "product_key"}
      }],
      "manualConfirmed": true
    },
    {
      "id": "join_category",
      "leftNodeId": "bridge_product_category",
      "rightNodeId": "dim_category",
      "joinType": "LEFT",
      "cardinality": "MANY_TO_ONE",
      "relationshipType": "DIRECT",
      "fanoutPolicy": "SAFE",
      "conditions": [{
        "leftExpression": {"type": "FIELD_REF", "nodeId": "bridge_product_category", "field": "category_key"},
        "operator": "EQUALS",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "dim_category", "field": "category_key"}
      }],
      "manualConfirmed": true
    }
  ],
  "factContract": {
    "businessAction": "订单行金额按商品品类分配",
    "grainKeyFields": ["order_line_id", "category_key"],
    "eventTimeField": "ordered_at",
    "atomicMeasures": [{"field": "allocated_amount", "additivity": "ADDITIVE", "unit": "CNY", "currency": "CNY", "nullPolicy": "REJECT"}]
  },
  "fields": [
    {"id": "field_order_line_id", "code": "order_line_id", "name": "订单行标识", "role": "IDENTIFIER", "expression": {"type": "FIELD_REF", "nodeId": "fact_order_lines", "field": "order_line_id"}, "canonicalType": "STRING", "nullable": false},
    {"id": "field_category_key", "code": "category_key", "name": "品类键", "role": "IDENTIFIER", "expression": {"type": "FIELD_REF", "nodeId": "bridge_product_category", "field": "category_key"}, "canonicalType": "STRING", "nullable": false},
    {"id": "field_category_name", "code": "category_name", "name": "品类名称", "role": "DIMENSION", "expression": {"type": "FIELD_REF", "nodeId": "dim_category", "field": "category_name"}, "canonicalType": "STRING", "nullable": true},
    {"id": "field_ordered_at", "code": "ordered_at", "name": "下单时间", "role": "TIME", "expression": {"type": "FIELD_REF", "nodeId": "fact_order_lines", "field": "ordered_at"}, "canonicalType": "DATETIME", "nullable": false},
    {"id": "field_allocated_amount", "code": "allocated_amount", "name": "品类分配金额", "role": "MEASURE", "expression": {"type": "MULTIPLY", "arguments": [{"type": "FIELD_REF", "nodeId": "fact_order_lines", "field": "line_amount"}, {"type": "FIELD_REF", "nodeId": "bridge_product_category", "field": "allocation_weight"}]}, "canonicalType": "DECIMAL", "unit": "CNY", "nullable": false}
  ],
  "filters": [],
  "groupBy": [],
  "having": [],
  "sorts": [],
  "parameters": [],
  "outputGrain": {"description": "每行一个订单行与品类分配关系", "keyFields": ["order_line_id", "category_key"], "timeField": "ordered_at", "defaultTimeGrain": "DAY"},
  "executionPolicy": {"mode": "REALTIME", "timeoutMs": 5000, "previewLimit": 100, "resultLimit": 10000, "cacheTtlSeconds": 0, "materialization": {"enabled": false}}
}
