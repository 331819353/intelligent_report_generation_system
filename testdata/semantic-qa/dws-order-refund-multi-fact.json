{
  "dslVersion": "1.0",
  "dataset": {
    "code": "dws_daily_customer_order_refund",
    "name": "客户日订单退款分析",
    "description": "订单与退款先聚合到客户日共同粒度再组合",
    "type": "SINGLE_SOURCE",
    "layer": "DWS",
    "semanticContractVersion": "1.0"
  },
  "nodes": [
    {"id": "orders", "type": "DATASET", "datasetVersionId": "30000000-0000-4000-8000-000000000001", "alias": "orders", "projection": ["stat_date", "customer_key", "order_amount"], "sourceFilters": []},
    {"id": "refunds", "type": "DATASET", "datasetVersionId": "30000000-0000-4000-8000-000000000002", "alias": "refunds", "projection": ["stat_date", "customer_key", "refund_amount"], "sourceFilters": []}
  ],
  "joins": [{
    "id": "join_daily_customer",
    "leftNodeId": "orders",
    "rightNodeId": "refunds",
    "joinType": "FULL",
    "cardinality": "ONE_TO_ONE",
    "relationshipType": "DIRECT",
    "fanoutPolicy": "SAFE",
    "conditions": [
      {
        "leftExpression": {"type": "FIELD_REF", "nodeId": "orders", "field": "stat_date"},
        "operator": "EQUALS",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "refunds", "field": "stat_date"}
      },
      {
        "leftExpression": {"type": "FIELD_REF", "nodeId": "orders", "field": "customer_key"},
        "operator": "EQUALS",
        "rightExpression": {"type": "FIELD_REF", "nodeId": "refunds", "field": "customer_key"}
      }
    ],
    "manualConfirmed": true
  }],
  "preAggregations": [
    {
      "id": "aggregate_orders",
      "nodeId": "orders",
      "joinId": "join_daily_customer",
      "joinSide": "LEFT",
      "groupBy": [{"field": "stat_date", "unit": "DAY"}, {"field": "customer_key"}],
      "metrics": [{"field": "order_amount", "function": "SUM"}]
    },
    {
      "id": "aggregate_refunds",
      "nodeId": "refunds",
      "joinId": "join_daily_customer",
      "joinSide": "RIGHT",
      "groupBy": [{"field": "stat_date", "unit": "DAY"}, {"field": "customer_key"}],
      "metrics": [{"field": "refund_amount", "function": "SUM"}]
    }
  ],
  "analysisContract": {
    "intent": "MULTI_FACT_COMPARISON",
    "inputMode": "MULTI_FACT",
    "commonGrainFields": ["stat_date", "customer_key"],
    "conformedDimensions": ["stat_date", "customer_key"],
    "timeField": "stat_date",
    "timeGrain": "DAY",
    "measures": [
      {"field": "order_amount", "sourceNodeIds": ["orders"], "aggregation": "SUM", "additivity": "ADDITIVE", "unit": "CNY", "currency": "CNY"},
      {"field": "refund_amount", "sourceNodeIds": ["refunds"], "aggregation": "SUM", "additivity": "ADDITIVE", "unit": "CNY", "currency": "CNY"}
    ]
  },
  "fields": [
    {"id": "field_stat_date", "code": "stat_date", "name": "统计日期", "role": "TIME", "expression": {"type": "FIELD_REF", "nodeId": "orders", "field": "stat_date"}, "canonicalType": "DATE", "nullable": false},
    {"id": "field_customer_key", "code": "customer_key", "name": "客户键", "role": "DIMENSION", "expression": {"type": "FIELD_REF", "nodeId": "orders", "field": "customer_key"}, "canonicalType": "STRING", "nullable": false},
    {"id": "field_order_amount", "code": "order_amount", "name": "订单金额", "role": "MEASURE", "expression": {"type": "FIELD_REF", "nodeId": "orders", "field": "order_amount"}, "canonicalType": "DECIMAL", "unit": "CNY", "nullable": true},
    {"id": "field_refund_amount", "code": "refund_amount", "name": "退款金额", "role": "MEASURE", "expression": {"type": "FIELD_REF", "nodeId": "refunds", "field": "refund_amount"}, "canonicalType": "DECIMAL", "unit": "CNY", "nullable": true}
  ],
  "filters": [],
  "groupBy": [],
  "having": [],
  "sorts": [{"fieldId": "field_stat_date", "direction": "ASC"}],
  "parameters": [],
  "outputGrain": {"description": "每行一个客户在一个自然日的订单与退款", "keyFields": ["stat_date", "customer_key"], "timeField": "stat_date", "defaultTimeGrain": "DAY"},
  "executionPolicy": {"mode": "MATERIALIZED_PREFERRED", "timeoutMs": 5000, "previewLimit": 100, "resultLimit": 10000, "cacheTtlSeconds": 300, "materialization": {"enabled": true, "refreshMode": "MANUAL"}}
}
