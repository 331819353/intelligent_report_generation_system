{
  "dslVersion": "1.0",
  "dataset": {
    "code": "dws_monthly_order_trend",
    "name": "月度订单趋势",
    "description": "单一订单事实的市场通用趋势分析",
    "type": "SINGLE_SOURCE",
    "layer": "DWS",
    "semanticContractVersion": "1.0"
  },
  "nodes": [{"id": "orders", "type": "DATASET", "datasetVersionId": "30000000-0000-4000-8000-000000000003", "alias": "orders", "projection": ["ordered_at", "amount"], "sourceFilters": []}],
  "joins": [],
  "analysisContract": {
    "intent": "TREND",
    "inputMode": "SINGLE_FACT",
    "commonGrainFields": ["stat_month"],
    "conformedDimensions": ["stat_month"],
    "timeField": "stat_month",
    "timeGrain": "MONTH",
    "measures": [{"field": "order_amount", "sourceNodeIds": ["orders"], "aggregation": "SUM", "additivity": "ADDITIVE", "unit": "CNY", "currency": "CNY"}]
  },
  "fields": [
    {"id": "field_stat_month", "code": "stat_month", "name": "统计月份", "role": "TIME", "expression": {"type": "DATE_TRUNC", "unit": "MONTH", "argument": {"type": "FIELD_REF", "nodeId": "orders", "field": "ordered_at"}}, "canonicalType": "DATE", "nullable": false},
    {"id": "field_order_amount", "code": "order_amount", "name": "订单金额", "role": "MEASURE", "expression": {"type": "AGGREGATE", "function": "SUM", "argument": {"type": "FIELD_REF", "nodeId": "orders", "field": "amount"}}, "canonicalType": "DECIMAL", "unit": "CNY", "nullable": false}
  ],
  "filters": [],
  "groupBy": ["field_stat_month"],
  "having": [],
  "sorts": [{"fieldId": "field_stat_month", "direction": "ASC"}],
  "parameters": [],
  "outputGrain": {"description": "每行一个自然月", "keyFields": ["stat_month"], "timeField": "stat_month", "defaultTimeGrain": "MONTH"},
  "executionPolicy": {"mode": "MATERIALIZED_PREFERRED", "timeoutMs": 5000, "previewLimit": 100, "resultLimit": 10000, "cacheTtlSeconds": 300, "materialization": {"enabled": true, "refreshMode": "MANUAL"}}
}
