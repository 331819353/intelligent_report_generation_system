{
  "type": "line-trend",
  "version": "1.0.0",
  "renderer": "ECHARTS",
  "displayName": "趋势折线图",
  "category": "CHART",
  "minSize": { "w": 4, "h": 3 },
  "recommendedSize": { "w": 8, "h": 5 },
  "dataContract": {
    "dimensions": { "min": 1, "max": 2 },
    "measures": { "min": 1, "max": 5 },
    "timeField": { "required": false },
    "roles": ["X_AXIS", "Y_AXIS", "SERIES", "COLOR", "TIME", "TOOLTIP"]
  },
  "stackingRequiresAdditive": false,
  "optionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
	  "title": { "type": "string" },
	  "subtitle": { "type": "string" },
      "showLegend": { "type": "boolean" },
      "showLabel": { "type": "boolean" },
      "smooth": { "type": "boolean" },
      "topN": { "type": "integer", "minimum": 1, "maximum": 1000 },
      "colorPaletteRef": { "type": "string" },
      "nullPolicy": { "type": "string", "enum": ["GAP", "ZERO", "HIDE"] },
      "animation": { "type": "boolean" },
      "mobileLegendMode": { "type": "string", "enum": ["VISIBLE", "HIDDEN", "SCROLL"] }
    }
  },
  "defaultOptions": { "showLegend": true, "showLabel": false, "smooth": false, "nullPolicy": "GAP", "animation": true },
  "mobilePolicy": { "supported": true, "defaultLegendMode": "HIDDEN", "labelDegradation": "HIDE_WHEN_DENSE" },
  "supportedInteractions": ["CLICK_FILTER", "DRILL_DOWN", "BRUSH", "ZOOM"]
}
