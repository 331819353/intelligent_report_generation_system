{
  "type": "hierarchy-table",
  "version": "1.0.0",
  "renderer": "REACT",
  "displayName": "层级分析表",
  "category": "TABLE",
  "minSize": { "w": 6, "h": 4 },
  "recommendedSize": { "w": 12, "h": 6 },
