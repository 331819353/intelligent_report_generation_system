{
  "type": "pie-donut",
  "version": "1.0.0",
  "renderer": "ECHARTS",
  "displayName": "饼图与环形图",
  "category": "CHART",
  "minSize": { "w": 4, "h": 4 },
  "recommendedSize": { "w": 6, "h": 5 },
  "dataContract": {
    "dimensions": { "min": 1, "max": 1 },
    "measures": { "min": 1, "max": 1 },
    "timeField": { "required": false },
    "roles": ["CATEGORY", "VALUE", "COLOR", "LABEL", "TOOLTIP"]
  },
  "stackingRequiresAdditive": true,
  "optionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
	  "title": { "type": "string" },
	  "subtitle": { "type": "string" },
      "showLegend": { "type": "boolean" },
      "showLabel": { "type": "boolean" },
      "topN": { "type": "integer", "minimum": 1, "maximum": 100 },
      "colorPaletteRef": { "type": "string" },
      "animation": { "type": "boolean" },
      "mobileLegendMode": { "type": "string", "enum": ["VISIBLE", "HIDDEN", "SCROLL"] }
    }
  },
  "defaultOptions": { "showLegend": true, "showLabel": true, "topN": 8, "animation": true, "mobileLegendMode": "HIDDEN" },
  "mobilePolicy": { "supported": true, "defaultLegendMode": "HIDDEN", "labelDegradation": "HIDE_WHEN_DENSE" },
  "supportedInteractions": ["CLICK_FILTER", "DRILL_DOWN"]
}
