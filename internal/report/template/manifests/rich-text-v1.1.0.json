{
  "type": "rich-text",
  "version": "1.1.0",
  "renderer": "TEXT",
  "displayName": "富文本",
  "category": "CONTENT",
  "minSize": { "w": 2, "h": 1 },
  "recommendedSize": { "w": 8, "h": 3 },
  "dataContract": {
    "dimensions": { "min": 0, "max": 0 },
    "measures": { "min": 0, "max": 0 },
    "timeField": { "required": false },
    "roles": []
  },
  "stackingRequiresAdditive": false,
  "optionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["richText"],
    "properties": {
      "richText": { "type": "string" },
      "angleInsightConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysisApproach", "analysisItems"],
        "properties": {
          "analysisApproach": {
            "type": "object",
            "additionalProperties": false,
            "required": ["howToAnalyze", "analyzeWhat", "doNotAnalyze", "outputExample"],
            "properties": {
              "howToAnalyze": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "analyzeWhat": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "doNotAnalyze": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "outputExample": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "analysisItems": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subsectionId", "weight"],
              "properties": {
                "subsectionId": { "type": "string", "minLength": 1, "maxLength": 128 },
                "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        }
      }
    }
  },
  "defaultOptions": { "richText": "" },
  "mobilePolicy": { "supported": true, "defaultLegendMode": "HIDDEN", "labelDegradation": "ELLIPSIS" },
  "supportedInteractions": []
}
