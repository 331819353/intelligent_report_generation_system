{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intelligent-report.local/report-plan-v1.schema.json",
  "title": "Report Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportTemplateVersion", "sections"],
  "properties": {
    "reportTemplateVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sections": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "shortText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "field": { "type": "string", "minLength": 1, "maxLength": 128 },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "purpose", "blocks"],
      "properties": {
        "title": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/shortText" },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 300, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "recommendedComponent", "dataRoles", "analysisMethods", "desktopHint", "mobileHint"],
      "properties": {
        "purpose": { "$ref": "#/$defs/shortText" },
        "recommendedComponent": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "dataRoles": {
          "type": "object", "additionalProperties": false,
          "required": ["dimensions", "measures"],
          "properties": {
            "dimensions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/field" } },
            "measures": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/field" } }
          }
        },
        "analysisMethods": {
          "type": "array", "maxItems": 11, "uniqueItems": true,
          "items": { "enum": ["CURRENT_VALUE", "PERIOD_COMPARISON", "TREND", "ANOMALY_POINT", "TOP_N", "CONTRIBUTION", "MAX_CHANGE", "TARGET_ACHIEVEMENT", "GROUP_DIFFERENCE", "SHARE_OF_TOTAL", "DATA_COMPLETENESS"] }
        },
        "desktopHint": {
          "type": "object", "additionalProperties": false, "required": ["w", "h"],
          "properties": { "w": { "type": "integer", "minimum": 1, "maximum": 24 }, "h": { "type": "integer", "minimum": 1, "maximum": 100 } }
        },
        "mobileHint": {
          "type": "object", "additionalProperties": false, "required": ["order"],
          "properties": { "order": { "type": "integer", "minimum": 1, "maximum": 300 } }
        }
      }
    }
  }
}
