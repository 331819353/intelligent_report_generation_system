{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chart Recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["componentType", "componentVersion", "ruleId", "ruleVersion", "priority"],
  "properties": {
    "componentType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "componentVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
    "ruleVersion": { "const": "1.0.0" },
    "priority": { "type": "integer", "minimum": 1 }
  }
}
