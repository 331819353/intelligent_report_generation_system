{
  "title": "Question Understanding V1",
  "description": "Strict mention-level intent contract. Physical tables, columns, SQL and arbitrary semantic object definitions are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "question",
    "domainHypotheses",
    "metricMentions",
    "dimensionMentions",
    "valueMentions",
    "time",
    "comparisons",
    "ordering",
    "limit",
    "unresolvedSpans"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "domainHypotheses": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/domainHypothesis" }
    },
    "metricMentions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/metricMention" }
    },
    "dimensionMentions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/dimensionMention" }
    },
    "valueMentions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/valueMention" }
    },
    "time": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "span", "grain", "timezone"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "grain": { "enum": ["DAY", "WEEK", "MONTH", "QUARTER", "YEAR"] },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "comparisons": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/comparisonMention" }
    },
    "ordering": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/orderingMention" }
    },
    "limit": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
    "unresolvedSpans": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/unresolvedSpan" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "end": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "sourceId", "contentHash"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": [
            "EXACT_ALIAS",
            "LEXICAL_MATCH",
            "VECTOR_MATCH",
            "GRAPH_PATH",
            "SEMANTIC_CONTRACT",
            "CERTIFIED_EXAMPLE",
            "DIMENSION_PROFILE",
            "CANDIDATE_SET",
            "DATA_QUALITY",
            "QUERY_PLAN",
            "QUERY_RESULT",
            "POLICY",
            "RULE",
            "CONVERSATION"
          ]
        },
        "sourceId": { "$ref": "#/$defs/stableId" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "domainHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainId", "score", "evidenceRefs"],
      "properties": {
        "domainId": { "$ref": "#/$defs/stableId" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "metricMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "aggregationHint"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "aggregationHint": { "enum": ["DEFAULT", "SUM", "AVG", "MIN", "MAX", "COUNT", "COUNT_DISTINCT"] }
      }
    },
    "dimensionMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "role", "grain"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "role": { "enum": ["GROUP_BY", "FILTER", "TIME", "SORT"] },
        "grain": { "enum": [null, "DAY", "WEEK", "MONTH", "QUARTER", "YEAR"] }
      }
    },
    "valueMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "dimensionHint", "operatorHint"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "dimensionHint": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "operatorHint": { "enum": ["DEFAULT", "EQUALS", "NOT_EQUALS", "IN", "NOT_IN"] }
      }
    },
    "comparisonMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "type", "targetText"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "type": { "enum": ["YEAR_OVER_YEAR", "MONTH_OVER_MONTH", "PERIOD_OVER_PERIOD", "DELTA", "RATIO"] },
        "targetText": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 }
      }
    },
    "orderingMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "targetText", "direction"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "targetText": { "type": "string", "minLength": 1, "maxLength": 256 },
        "direction": { "enum": ["ASC", "DESC"] }
      }
    },
    "unresolvedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span", "reason", "neededEvidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "span": { "$ref": "#/$defs/span" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
        "neededEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "METRIC_CANDIDATES",
              "DIMENSION_CANDIDATES",
              "MEMBER_CANDIDATES",
              "TIME_RESOLUTION",
              "GRAPH_PLAN",
              "CONVERSATION_CONTEXT"
            ]
          }
        }
      }
    }
  }
}
