{
  "title": "Answer Artifact v1",
  "description": "Closed structured and verified narrative answer contract with Unicode citation spans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "layers", "verification", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "layers": { "$ref": "#/$defs/layers" },
    "verification": { "$ref": "#/$defs/verification" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "metricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricVersionId", "value", "unit", "currency", "label", "columnKey"],
      "properties": {
        "metricVersionId": { "$ref": "#/$defs/stableId" },
        "value": { "$ref": "#/$defs/decimal" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "currency": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 16 }, { "type": "null" }] },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "columnKey": { "$ref": "#/$defs/stableId" }
      }
    },
    "chartSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "datasetId", "categoryColumnKey", "valueColumnKeys"],
      "properties": {
        "type": { "enum": ["LINE", "BAR", "TABLE", "KPI"] },
        "datasetId": { "$ref": "#/$defs/stableId" },
        "categoryColumnKey": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "valueColumnKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "structured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "cards", "chartSpec", "tableRef"],
      "properties": {
        "headline": { "oneOf": [{ "$ref": "#/$defs/metricValue" }, { "type": "null" }] },
        "cards": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/metricValue" } },
        "chartSpec": { "oneOf": [{ "$ref": "#/$defs/chartSpec" }, { "type": "null" }] },
        "tableRef": { "$ref": "#/$defs/stableId" }
      }
    },
    "textSpan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 16384 }
    },
    "resultCellCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textSpan", "kind", "rowKey", "columnKey"],
      "properties": {
        "textSpan": { "$ref": "#/$defs/textSpan" },
        "kind": { "const": "RESULT_CELL" },
        "rowKey": { "type": "string", "minLength": 3, "maxLength": 8192 },
        "columnKey": { "$ref": "#/$defs/stableId" }
      }
    },
    "contractCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textSpan", "kind", "contractId"],
      "properties": {
        "textSpan": { "$ref": "#/$defs/textSpan" },
        "kind": { "const": "CONTRACT" },
        "contractId": { "$ref": "#/$defs/stableId" }
      }
    },
    "timeSpecCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textSpan", "kind"],
      "properties": {
        "textSpan": { "$ref": "#/$defs/textSpan" },
        "kind": { "const": "TIME_SPEC" }
      }
    },
    "citation": {
      "oneOf": [
        { "$ref": "#/$defs/resultCellCitation" },
        { "$ref": "#/$defs/contractCitation" },
        { "$ref": "#/$defs/timeSpecCitation" }
      ]
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "citations"],
      "properties": {
        "summary": { "type": "string", "maxLength": 4096 },
        "findings": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "citations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/citation" } }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured", "narrative"],
      "properties": {
        "structured": { "$ref": "#/$defs/structured" },
        "narrative": { "$ref": "#/$defs/narrative" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifierVersion", "policyWordlistVersion", "attempts", "passed", "degraded"],
      "properties": {
        "verifierVersion": { "$ref": "#/$defs/stableId" },
        "policyWordlistVersion": { "$ref": "#/$defs/stableId" },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
        "passed": { "type": "boolean" },
        "degraded": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptVersion", "modelPolicy", "evidenceHash", "resultHash", "semanticReleaseId", "chartRuleVersion"],
      "properties": {
        "promptVersion": { "$ref": "#/$defs/stableId" },
        "modelPolicy": { "$ref": "#/$defs/stableId" },
        "evidenceHash": { "$ref": "#/$defs/contentHash" },
        "resultHash": { "$ref": "#/$defs/contentHash" },
        "semanticReleaseId": { "$ref": "#/$defs/stableId" },
        "chartRuleVersion": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
