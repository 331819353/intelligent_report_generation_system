{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-report.local/schemas/semantic-query-ir-v1.schema.json",
  "title": "Semantic Query IR v1",
  "description": "统一 Question Orchestrator 内部使用的版本化语义查询合同。该对象由服务端从已认证 QueryPlan 构建，API 调用方不能直接提交执行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "semanticVersion",
    "metrics",
    "dimensions",
    "filters",
    "orderBy",
    "limit",
    "evidenceIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "const": "semantic" },
    "semanticVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/metric" }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "time": { "$ref": "#/$defs/timeRange" },
    "filters": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/filter" }
    },
    "orderBy": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/order" }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "metricVersionId", "code"],
      "properties": {
        "metricId": { "type": "string", "format": "uuid" },
        "metricVersionId": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "endExclusive"],
      "properties": {
        "start": { "$ref": "#/$defs/timeBoundary" },
        "endExclusive": { "$ref": "#/$defs/timeBoundary" }
      }
    },
    "timeBoundary": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionId", "dimensionCode", "operator", "valueIds"],
      "properties": {
        "dimensionId": { "type": "string", "format": "uuid" },
        "dimensionCode": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
        "operator": { "enum": ["IN"] },
        "valueIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "direction"],
      "properties": {
        "member": { "type": "string", "minLength": 1, "maxLength": 128 },
        "direction": { "enum": ["ASC", "DESC"] }
      }
    }
  }
}
