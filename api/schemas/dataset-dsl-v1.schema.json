{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-report.local/schemas/dataset-dsl-v1.schema.json",
  "title": "数据集 DSL V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dslVersion", "dataset", "nodes", "joins", "fields", "filters", "groupBy", "having", "sorts", "parameters", "outputGrain", "executionPolicy"],
  "properties": {
    "dslVersion": { "const": "1.0" },
    "dataset": { "$ref": "#/$defs/dataset" },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/node" } },
    "joins": { "type": "array", "items": { "$ref": "#/$defs/join" } },
    "transforms": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/transform" } },
    "preAggregations": { "type": "array", "items": { "$ref": "#/$defs/preAggregation" } },
    "factContract": { "$ref": "#/$defs/factContract" },
    "analysisContract": { "$ref": "#/$defs/analysisContract" },
    "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
    "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
    "groupBy": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "groupByMode": { "enum": ["STANDARD", "CUBE", "ROLLUP", "GROUPING_SETS"] },
    "groupingSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
      "uniqueItems": true
    },
    "having": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
    "sorts": { "type": "array", "items": { "$ref": "#/$defs/sort" } },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "outputGrain": { "$ref": "#/$defs/outputGrain" },
    "executionPolicy": { "$ref": "#/$defs/executionPolicy" },
    "designer": { "type": "object" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
    "physicalIdentifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_$#]{0,127}$" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "type"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "domain": {
          "description": "数据集所属业务领域，作为版本化治理信息保存",
          "type": "string",
          "maxLength": 128
        },
        "subject": {
          "description": "数据集所属分析或业务主题，作为版本化治理信息保存",
          "type": "string",
          "maxLength": 128
        },
        "type": { "enum": ["SINGLE_SOURCE", "CROSS_SOURCE"] },
        "layer": {
          "description": "数据集的粒度合同（ODS 贴源 / DIM 实体 / DWD 明细 / DWS 汇总 / ADS 应用）。血缘方式由拓扑推导：恰好一个物理 TABLE 节点且无 Join 为源表直落，可声明任意层级并保持源表既有粒度；全部引用已发布数据集版本为分层加工，上游层级须满足 ODS→DIM/DWD→DWS→ADS。历史 DSL 可省略并由服务端确定性推断",
          "enum": ["ODS", "DIM", "DWD", "DWS", "ADS"]
        },
        "sourceMode": {
          "description": "遗留字段：早期分类器为源端已汇总的单表 DWS 写入 PRE_AGGREGATED；语义等价于源表直落的 DWS，新文档不再写入",
          "deprecated": true,
          "const": "PRE_AGGREGATED"
        },
        "semanticContractVersion": { "const": "1.0" },
        "consumerContractId": { "type": "string", "format": "uuid" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "alias", "projection", "sourceFilters"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["TABLE", "DATASET"] },
        "datasourceId": { "type": "string", "minLength": 1 },
        "tableId": { "type": "string", "minLength": 1 },
        "datasetVersionId": { "type": "string", "minLength": 1 },
        "fileVersionId": { "type": "string", "minLength": 1 },
        "alias": { "$ref": "#/$defs/identifier" },
        "projection": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/physicalIdentifier" }, "uniqueItems": true },
        "sourceFilters": { "type": "array", "items": { "$ref": "#/$defs/sourceFilter" } }
      }
    },
    "sourceFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/physicalIdentifier" },
        "operator": { "enum": ["EQUALS", "NOT_EQUALS", "GT", "GTE", "LT", "LTE", "IN", "NOT_IN", "IS_NULL", "IS_NOT_NULL"] },
        "value": true,
        "expression": { "$ref": "#/$defs/expression" }
      },
      "anyOf": [
        { "required": ["field", "operator"] },
        { "required": ["expression"] }
      ]
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "leftNodeId", "rightNodeId", "joinType", "cardinality", "conditions", "manualConfirmed"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "leftNodeId": { "$ref": "#/$defs/identifier" },
        "rightNodeId": { "$ref": "#/$defs/identifier" },
        "joinType": { "enum": ["INNER", "LEFT", "RIGHT", "FULL"] },
        "cardinality": { "enum": ["ONE_TO_ONE", "MANY_TO_ONE", "ONE_TO_MANY", "MANY_TO_MANY"] },
        "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/joinCondition" } },
        "manualConfirmed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "joinType": { "const": "INNER" } } },
          "then": { "properties": { "cardinality": { "const": "ONE_TO_ONE" } } }
        },
        {
          "if": { "properties": { "joinType": { "const": "LEFT" } } },
          "then": { "properties": { "cardinality": { "const": "MANY_TO_ONE" } } }
        },
        {
          "if": { "properties": { "joinType": { "const": "RIGHT" } } },
          "then": { "properties": { "cardinality": { "const": "ONE_TO_MANY" } } }
        },
        {
          "if": { "properties": { "joinType": { "const": "FULL" } } },
          "then": { "properties": { "cardinality": { "const": "MANY_TO_MANY" } } }
        }
      ]
    },
    "joinCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leftExpression", "operator", "rightExpression"],
      "properties": {
        "leftExpression": { "$ref": "#/$defs/expression" },
        "operator": { "enum": ["EQUALS", "NOT_EQUALS", "GT", "GTE", "LT", "LTE"] },
        "rightExpression": { "$ref": "#/$defs/expression" }
      }
    },
    "preAggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "joinId", "joinSide", "groupBy", "metrics"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "joinId": { "$ref": "#/$defs/identifier" },
        "joinSide": { "enum": ["LEFT", "RIGHT"] },
        "groupBy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/preAggregationGroup" } },
        "groupByMode": { "enum": ["STANDARD", "CUBE", "ROLLUP", "GROUPING_SETS"] },
        "groupingSets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "array", "items": { "$ref": "#/$defs/physicalIdentifier" }, "uniqueItems": true },
          "uniqueItems": true
        },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/preAggregationMetric" } }
      }
    },
    "preAggregationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/physicalIdentifier" },
        "unit": { "enum": ["DAY", "WEEK", "MONTH", "QUARTER", "YEAR"] },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "preAggregationMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "function"],
      "properties": {
        "field": { "$ref": "#/$defs/physicalIdentifier" },
        "function": { "enum": ["SUM", "AVG", "MIN", "MAX", "COUNT", "COUNT_DISTINCT"] },
        "countRows": { "type": "boolean" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "transformInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["NODE", "JOIN", "GROUP", "TRANSFORM"] },
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "transformOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "code", "canonicalType"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "code": { "$ref": "#/$defs/identifier" },
        "canonicalType": { "$ref": "#/$defs/dataType" }
      }
    },
    "transformRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "inputKeys", "output", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "operation": { "enum": ["WINDOW", "CURRENT_DATE", "DATE_DIFF", "DATE_EXTRACT", "DATE_START", "DATE_END", "DATE_FORMAT", "CAST", "ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "ROUND", "ABS", "FLOOR", "CEIL", "CONCAT", "COALESCE", "CASE", "SUBSTRING", "TRIM", "UPPER", "LOWER", "REPLACE"] },
        "inputKeys": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}\\.[A-Za-z][A-Za-z0-9_$#]{0,127}$" }
        },
        "output": { "$ref": "#/$defs/transformOutput" },
        "expression": { "$ref": "#/$defs/expression" },
        "replaceSourceKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}\\.[A-Za-z][A-Za-z0-9_$#]{0,127}$" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "family", "componentType", "input", "rules"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "family": { "enum": ["DATE", "TEXT", "CAST", "NUMBER", "CONDITION", "NULL", "WINDOW", "SPLIT_MERGE"] },
        "componentType": { "enum": ["FILTER", "WINDOW_FUNCTION", "DATE_CALCULATION", "DATE_FORMAT", "TEXT_CASE", "TEXT_UPPER", "TEXT_TRIM", "TEXT_REPLACE", "TEXT_LOWER", "TEXT_SUBSTRING", "TEXT_CONCAT", "NUMBER_ABSOLUTE", "NUMBER_ROUNDING", "NUMBER_ARITHMETIC", "CAST", "CONDITION", "NULL"] },
        "input": { "$ref": "#/$defs/transformInput" },
        "rules": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/transformRule" } }
      }
    },
    "factContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["businessAction", "grainKeyFields", "atomicMeasures"],
      "properties": {
        "businessAction": { "type": "string", "minLength": 1, "maxLength": 256 },
        "grainKeyFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "eventTimeField": { "$ref": "#/$defs/identifier" },
        "atomicMeasures": { "type": "array", "items": { "$ref": "#/$defs/atomicMeasureContract" } }
      }
    },
    "atomicMeasureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "additivity", "nullPolicy"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "additivity": { "enum": ["ADDITIVE", "SEMI_ADDITIVE", "NON_ADDITIVE"] },
        "valueBehavior": { "enum": ["FLOW", "CUMULATIVE", "POINT_IN_TIME", "NON_ADDITIVE"] },
        "defaultAggregation": { "enum": ["SUM", "MIN", "MAX", "COUNT", "COUNT_DISTINCT", "AVG"] },
        "timeAggregation": { "enum": ["SUM", "LAST", "NONE"] },
        "unit": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 16 },
        "nullPolicy": { "enum": ["PRESERVE", "ZERO", "REJECT"] }
      }
    },
    "analysisContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "inputMode", "commonGrainFields", "conformedDimensions", "measures"],
      "properties": {
        "intent": { "enum": ["TREND", "PERIOD_COMPARISON", "DISTRIBUTION", "RANKING", "TOP_N", "DRILLDOWN", "FUNNEL", "RETENTION", "LIFECYCLE", "ANOMALY", "CONTRIBUTION", "MULTI_FACT_COMPARISON", "ENTITY_COUNT"] },
        "inputMode": { "enum": ["SINGLE_FACT", "MULTI_FACT"] },
        "commonGrainFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "conformedDimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "timeField": { "$ref": "#/$defs/identifier" },
        "timeGrain": { "enum": ["DAY", "WEEK", "MONTH", "QUARTER", "YEAR"] },
        "measures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analysisMeasureContract" } }
      }
    },
    "analysisMeasureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "sourceNodeIds", "aggregation", "additivity"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "sourceNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "aggregation": { "enum": ["SUM", "MIN", "MAX", "COUNT", "COUNT_DISTINCT", "AVG"] },
        "additivity": { "enum": ["ADDITIVE", "SEMI_ADDITIVE", "NON_ADDITIVE"] },
        "valueBehavior": { "enum": ["FLOW", "CUMULATIVE", "POINT_IN_TIME", "NON_ADDITIVE"] },
        "timeAggregation": { "enum": ["SUM", "LAST", "NONE"] },
        "unit": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 16 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "role", "expression", "canonicalType", "nullable"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "role": { "enum": ["DIMENSION", "MEASURE", "ATTRIBUTE", "TIME", "IDENTIFIER"] },
        "expression": { "$ref": "#/$defs/expression" },
        "canonicalType": { "$ref": "#/$defs/dataType" },
        "semanticType": { "type": "string", "maxLength": 100 },
        "aggregation": { "type": "string", "maxLength": 40 },
        "format": { "type": "string", "maxLength": 100 },
        "unit": { "type": "string", "maxLength": 40 },
        "nullable": { "type": "boolean" },
        "visible": { "type": "boolean" }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "optional", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "stage": { "enum": ["PRE_AGGREGATION", "POST_AGGREGATION"] },
        "optional": { "type": "boolean" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "direction"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["ASC", "DESC"] },
        "nulls": { "enum": ["FIRST", "LAST"] }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "dataType", "multiValue", "required"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dataType": { "$ref": "#/$defs/dataType" },
        "multiValue": { "type": "boolean" },
        "required": { "type": "boolean" },
        "defaultValue": true
      }
    },
    "outputGrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "keyFields"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "keyFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "timeField": { "$ref": "#/$defs/identifier" },
        "defaultTimeGrain": { "enum": ["DAY", "WEEK", "MONTH", "QUARTER", "YEAR"] }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timeoutMs", "previewLimit", "resultLimit", "cacheTtlSeconds", "materialization"],
      "properties": {
        "mode": { "enum": ["REALTIME", "CACHE_PREFERRED", "MATERIALIZED_PREFERRED"] },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "previewLimit": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "resultLimit": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "cacheTtlSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "refreshMode": { "enum": ["MANUAL", "SCHEDULED", "ON_DEMAND"] },
            "cron": { "type": "string", "maxLength": 120 }
          }
        }
      }
    },
    "dataType": { "enum": ["STRING", "INTEGER", "DECIMAL", "BOOLEAN", "DATE", "DATETIME"] },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["FIELD_REF", "PARAM_REF", "LITERAL", "ARRAY", "CURRENT_DATE", "DATE_DIFF", "DATE_EXTRACT", "DATE_START", "DATE_END", "DATE_TRUNC", "DATE_FORMAT", "AGGREGATE", "WINDOW", "CAST", "ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "ROUND", "ABS", "FLOOR", "CEIL", "CONCAT", "COALESCE", "SUBSTRING", "TRIM", "UPPER", "LOWER", "REPLACE", "EQUALS", "NOT_EQUALS", "GT", "GTE", "LT", "LTE", "LIKE", "CONTAINS", "NOT_CONTAINS", "IN", "NOT_IN", "BETWEEN", "IS_NULL", "IS_NOT_NULL", "AND", "OR", "NOT", "CASE"] },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "field": { "$ref": "#/$defs/physicalIdentifier" },
        "code": { "$ref": "#/$defs/identifier" },
        "function": { "enum": ["SUM", "AVG", "MIN", "MAX", "COUNT", "COUNT_DISTINCT", "ROW_NUMBER", "RANK", "DENSE_RANK"] },
        "unit": { "enum": ["DAY", "WEEK", "MONTH", "QUARTER", "YEAR", "WEEKDAY", "DAY_OF_YEAR"] },
        "targetType": { "$ref": "#/$defs/dataType" },
        "value": true,
        "argument": { "$ref": "#/$defs/expression" },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
        "partitionBy": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
        "orderBy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression", "direction"],
            "properties": {
              "expression": { "$ref": "#/$defs/expression" },
              "direction": { "enum": ["ASC", "DESC"] }
            }
          }
        },
        "left": { "$ref": "#/$defs/expression" },
        "right": { "$ref": "#/$defs/expression" },
        "lower": { "$ref": "#/$defs/expression" },
        "upper": { "$ref": "#/$defs/expression" },
        "whens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "then"],
            "properties": {
              "when": { "$ref": "#/$defs/expression" },
              "then": { "$ref": "#/$defs/expression" }
            }
          }
        },
        "else": { "$ref": "#/$defs/expression" }
      }
    }
  }
}
