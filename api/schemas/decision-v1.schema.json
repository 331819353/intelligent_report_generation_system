{
  "title": "Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "domainId", "ownerUserId", "title", "question", "decision", "expectedEffect", "risks", "status", "evidenceMode", "options", "approvalPolicy", "reviewAt", "recordVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/uuid" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "domainId": { "$ref": "#/$defs/uuid" },
    "ownerUserId": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "decision": { "type": "string", "maxLength": 8192 },
    "expectedEffect": { "type": "string", "maxLength": 4096 },
    "risks": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "status": { "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "IN_EXECUTION", "REVIEW_DUE", "CLOSED", "REOPENED", "CANCELED"] },
    "evidenceMode": { "enum": ["PLATFORM_VERIFIED", "MANUAL_WITHOUT_PLATFORM_EVIDENCE"] },
    "options": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/option" } },
    "approvalPolicy": { "$ref": "#/$defs/approvalPolicy" },
    "reviewAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "recordVersion": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "selected"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 4096 },
        "selected": { "type": "boolean" }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "requiredApprovals", "approverUserIds"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requiredApprovals": { "type": "integer", "minimum": 1, "maximum": 16 },
        "approverUserIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    }
  }
}
